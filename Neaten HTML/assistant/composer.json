{
    "name": "neaten/assistant",
    "description": "Server-side endpoint for the Neaten Assistant on neatenclean.com",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "anthropic-ai/sdk": "^1.3",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Neaten\\Assistant\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
